// ============================================================
// TaskOrga — Prisma Schema (MVP, voller Funktionsumfang)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// MANDANT / BENUTZER / RECHTE
// ------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  address     String?
  zip         String?
  city        String?
  country     String?
  taxNumber   String? // Steuernummer
  vatId       String? // USt-IdNr.
  bankName    String?
  iban        String?
  bic         String?
  invoiceFooterText String? // erscheint z.B. auf Rechnungen/Angeboten
  logoUrl     String?

  // Angebots-/Rechnungsvorlage
  showVatOnDocuments  Boolean @default(true) // aus für Kleinunternehmer (§19 UStG)
  documentAccentColor String  @default("#2F5FFF")
  documentIntroText   String? // erscheint über der Positionstabelle

  // Angebots-/Rechnungs-Grundeinstellungen
  defaultQuoteValidityDays Int    @default(30)
  defaultDiscountType      String @default("AMOUNT") // AMOUNT | PERCENT
  quoteNumberFormat        String @default("ANG-{YYYY}-{NNNN}")
  invoiceNumberFormat      String @default("RE-{YYYY}-{NNNN}")
  projectNumberFormat      String @default("AUF-{YYYY}-{NNNN}")

  // Firmenweite Anpassungen (nur Admin)
  navLabels           Json? // { [navItemId]: "Eigener Menütext" }
  customerTabsConfig  Json? // [{ id, visible, order }] für den Kundenstamm

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  customers   Customer[]
  inquiries   Inquiry[]
  quotes      Quote[]
  projects    Project[]
  invoices    Invoice[]
  expenses    Expense[]
  tasks       Task[]
  documents   Document[]
  activities  Activity[]
  appointments Appointment[]
  automations Automation[]
  roles       Role[]
  workflowSteps WorkflowStep[]
  customKpis  CustomKpi[]
  documentTemplates DocumentTemplate[]
  reminderLevels    ReminderLevel[]
  itemTemplates     ItemTemplate[]
}

// Einladungscodes für die Registrierung neuer Firmenkonten. Nicht an eine
// Firma gebunden, da sie VOR der Firmen-Anlage geprüft werden.
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  note      String?
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model User {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  email     String   @unique
  name      String
  passwordHash String
  roleId    String?
  role      Role?    @relation(fields: [roleId], references: [id])
  navConfig Json? // gespeicherte Reihenfolge/Sichtbarkeit der Navigationspunkte

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTasks   Task[]        @relation("TaskAssignee")
  comments        Comment[]
  activities      Activity[]
  dashboards      Dashboard[]
  passwordResetTokens PasswordResetToken[]
  timeEntries         TimeEntry[]
}

// Token für den Selfservice-Passwort-vergessen-Link (per E-Mail verschickt)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Rollen- & Rechtekonzept (einfaches RBAC für MVP)
model Role {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  name        String // z.B. "Admin", "Mitarbeiter", "Buchhaltung"
  permissions Json   // z.B. { "customers": ["read","write"], "invoices": ["read"] }

  users User[]

  @@unique([companyId, name])
}

// ------------------------------------------------------------
// KUNDEN
// ------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  name        String // Anzeigename (bei Privatkunden automatisch aus Vor-/Nachname zusammengesetzt)
  salutation  CustomerSalutation?
  firstName   String?
  lastName    String?
  type        CustomerType @default(PRIVATE)
  email       String?
  phone       String?
  address     String?
  zip         String?
  city        String?
  country     String?
  notes       String?
  customerSince DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts     Contact[]
  inquiries    Inquiry[]
  quotes       Quote[]
  projects     Project[]
  invoices     Invoice[]
  appointments Appointment[]
  documents    Document[]
  tasks        Task[]
  activities   Activity[]
  comments     Comment[]
  insight      CustomerInsight?

  @@index([companyId])
}

enum CustomerType {
  PRIVATE
  BUSINESS
}

enum CustomerSalutation {
  HERR
  FRAU
  DIVERS
}

// Ansprechpartner bei Firmenkunden
model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  name  String
  role  String?
  email String?
  phone String?
}

// ------------------------------------------------------------
// ANFRAGE -> RÜCKRUF -> ANGEBOT
// ------------------------------------------------------------

model Inquiry {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  title       String
  description String?
  status      InquiryStatus @default(NEW)
  source      String? // z.B. "Telefon", "Website", "Empfehlung"
  amount      Decimal? @db.Decimal(12, 2) // geschätzter/vereinbarter Wert

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  quotes       Quote[]
  documents    Document[]
  tasks        Task[]
  activities   Activity[]
  stepEntries  InquiryStepEntry[]

  @@index([companyId, status])
}

// Die Schritte selbst sind pro Firma frei konfigurierbar (Wording,
// Reihenfolge, neue Schritte) — verwaltet unter Einstellungen.
model WorkflowStep {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  label String
  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries InquiryStepEntry[]

  @@unique([companyId, order])
  @@index([companyId])
}

// Pro Anfrage + Schritt: Erledigt-Status (grüner Haken), Notiz, Zeitpunkt.
model InquiryStepEntry {
  id        String       @id @default(cuid())
  inquiryId String
  inquiry   Inquiry      @relation(fields: [inquiryId], references: [id])
  stepId    String
  step      WorkflowStep @relation(fields: [stepId], references: [id])

  note        String?
  completedAt DateTime? // null = noch nicht erledigt; gesetzt = grüner Haken

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inquiryId, stepId])
}

enum InquiryStatus {
  NEW
  CALLBACK_SCHEDULED
  CALL_DONE
  QUOTE_CREATED
  WON
  LOST
}

// Terminanfrage (Rückruf), kein klassischer Kalendertermin
model Appointment {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  inquiryId  String?
  inquiry    Inquiry?  @relation(fields: [inquiryId], references: [id])

  title       String
  type        AppointmentType @default(CALLBACK_REQUEST)
  requestedAt DateTime?  // vom Kunden gewünschter Zeitraum (grob)
  scheduledAt DateTime?  // Von-Zeitpunkt
  endAt       DateTime?  // Bis-Zeitpunkt
  status      AppointmentStatus @default(REQUESTED)
  notes       String?
  amount      Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      Task[]
  activities Activity[]
}

enum AppointmentType {
  CALLBACK_REQUEST
  ON_SITE_VISIT
  MEETING
}

enum AppointmentStatus {
  REQUESTED
  SCHEDULED
  DONE
  CANCELLED
}

// ------------------------------------------------------------
// ANGEBOT
// ------------------------------------------------------------

model Quote {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  inquiryId  String?
  inquiry    Inquiry? @relation(fields: [inquiryId], references: [id])

  number    String   // fortlaufende Angebotsnummer
  title     String
  status    QuoteStatus @default(DRAFT)
  validUntil DateTime?
  totalNet   Decimal @db.Decimal(12, 2) @default(0)
  totalGross Decimal @db.Decimal(12, 2) @default(0)
  taxRate    Decimal @db.Decimal(5, 2) @default(19)
  discountValue Decimal? @db.Decimal(12, 2)
  discountType  String   @default("AMOUNT") // AMOUNT | PERCENT

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      QuoteItem[]
  versions   QuoteVersion[]
  project    Project?
  documents  Document[]
  tasks      Task[]
  activities Activity[]
  comments   Comment[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  position    Int
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unit        String  @default("Stk")
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(19) @db.Decimal(5, 2)
}

// ------------------------------------------------------------
// AUFTRAG (zentrales Objekt)
// ------------------------------------------------------------

model Project {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  quoteId    String?  @unique
  quote      Quote?   @relation(fields: [quoteId], references: [id])

  number String
  title  String
  status ProjectStatus @default(PLANNED)

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices     Invoice[]
  expenses     Expense[]
  tasks        Task[]
  documents    Document[]
  activities   Activity[]
  comments     Comment[]
  timeEntries  TimeEntry[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

// ------------------------------------------------------------
// RECHNUNG / AUSGABEN
// ------------------------------------------------------------

model Invoice {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])

  number     String
  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime?
  dueDate    DateTime?
  totalNet   Decimal @db.Decimal(12, 2) @default(0)
  totalGross Decimal @db.Decimal(12, 2) @default(0)
  taxRate    Decimal @db.Decimal(5, 2) @default(19)
  paidAt     DateTime?
  paidAmount Decimal @db.Decimal(12, 2) @default(0)
  reminderLevel      Int       @default(0) // 0=keine, 1=Erinnerung, 2=1.Mahnung, 3=2.Mahnung
  lastReminderSentAt DateTime?
  discountValue Decimal? @db.Decimal(12, 2)
  discountType  String   @default("AMOUNT") // AMOUNT | PERCENT

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      InvoiceItem[]
  documents  Document[]
  tasks      Task[]
  activities Activity[]
  comments   Comment[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  position    Int
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unit        String  @default("Stk")
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(19) @db.Decimal(5, 2)
}

model Expense {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])

  title    String
  category String?
  amount   Decimal  @db.Decimal(12, 2)
  date     DateTime
  status   ExpenseStatus @default(OPEN)
  paidAt   DateTime?
  receiptDocumentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@index([companyId, date])
}

enum ExpenseStatus {
  OPEN
  PAID
}

// ------------------------------------------------------------
// AUFGABEN (polymorph über explizite FKs)
// ------------------------------------------------------------

model Task {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  title       String
  description String?
  status      TaskStatus @default(OPEN)
  priority    TaskPriority @default(NORMAL)
  dueDate     DateTime?

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  // genau eine dieser Relationen ist gesetzt (Anwendungslogik prüft das)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  inquiryId     String?
  inquiry       Inquiry?     @relation(fields: [inquiryId], references: [id])
  quoteId       String?
  quote         Quote?       @relation(fields: [quoteId], references: [id])
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id])
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ------------------------------------------------------------
// DOKUMENTE (polymorph über explizite FKs)
// ------------------------------------------------------------

model Document {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  fileName String
  fileUrl  String
  mimeType String
  fileSize Int

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  inquiryId  String?
  inquiry    Inquiry?  @relation(fields: [inquiryId], references: [id])
  quoteId    String?
  quote      Quote?    @relation(fields: [quoteId], references: [id])
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])
  expenseId  String?
  expense    Expense?  @relation(fields: [expenseId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
}

// ------------------------------------------------------------
// TIMELINE / AKTIVITÄTEN (polymorph über explizite FKs)
// ------------------------------------------------------------

model Activity {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  type    String // z.B. "customer.created", "invoice.paid", "quote.sent"
  message String

  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  inquiryId     String?
  inquiry       Inquiry?     @relation(fields: [inquiryId], references: [id])
  quoteId       String?
  quote         Quote?       @relation(fields: [quoteId], references: [id])
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id])
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

// Kommentare (polymorph, schlanker als Activity)
model Comment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  content String

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  quoteId    String?
  quote      Quote?    @relation(fields: [quoteId], references: [id])
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// ZEITERFASSUNG (Grundgerüst)
// ------------------------------------------------------------

model TimeEntry {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  description String?
  minutes     Int
  date        DateTime

  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// AUTOMATISIERUNG (Grundgerüst für Workflow Builder)
// ------------------------------------------------------------

model Automation {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  name      String
  isActive  Boolean @default(true)
  trigger   Json // z.B. { "event": "invoice.overdue", "days": 7 }
  actions   Json // z.B. [{ "type": "create_task", "title": "Mahnung senden" }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// DASHBOARD (individualisierbar)
// ------------------------------------------------------------

// Frei erstellbare Kennzahlen-Kacheln fürs Dashboard: Nutzer wählt einen
// Datentyp (z.B. Anfragen), eine Berechnung (Anzahl/Summe) und optional
// einen Status-Filter. Die Berechnung selbst passiert serverseitig fest
// definiert je Datentyp (siehe lib/actions/custom-kpi.ts).
model CustomKpi {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  label       String
  entity      String // "customers" | "inquiries" | "quotes" | "projects" | "invoices" | "appointments" | "expenses"
  aggregation String // "count" | "sum"
  sumField    String?
  statusValue String?
  accent      String  @default("border-l-brand-500")

  createdAt DateTime @default(now())

  @@index([companyId])
}

// Vom Admin frei definierbare Vorlagen für Angebote/Rechnungen. Einleitungs-
// und Fußzeilentext dürfen Platzhalter wie {{kunde.name}} enthalten, die beim
// PDF-Erstellen automatisch durch echte Daten ersetzt werden ("Autofiller").
model DocumentTemplate {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  name        String
  type        DocumentTemplateType
  isDefault   Boolean @default(false)

  introText   String?
  footerText  String?
  showVat     Boolean @default(true)
  accentColor String  @default("#2F5FFF")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, type])
}

enum DocumentTemplateType {
  QUOTE
  INVOICE
}

// Vom Admin frei definierbare Mahnstufen (Standard: 3 Beispielstufen, siehe Seed).
// introText darf Platzhalter wie {{kunde.name}} enthalten.
model ReminderLevel {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  label        String
  order        Int
  daysAfterDue Int     @default(0) // Empfehlung: ab wann diese Stufe sinnvoll ist
  introText    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, order])
}

// Gespeicherte KI-Cross-Selling-Empfehlung pro Kunde (wird auf Knopfdruck neu erzeugt)
model CustomerInsight {
  id          String   @id @default(cuid())
  customerId  String   @unique
  customer    Customer @relation(fields: [customerId], references: [id])
  content     String
  generatedAt DateTime @default(now())
}

// Vordefinierte Positionen für Angebote/Rechnungen ("Bibliothek")
model ItemTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  description String
  unit        String   @default("Stk")
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @default(19) @db.Decimal(5, 2)
  createdAt   DateTime @default(now())

  @@index([companyId])
}

// Gespeicherter Stand eines Angebots zu einem Zeitpunkt (Versionierung)
model QuoteVersion {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id])
  versionNumber Int
  snapshot      Json // Titel, Positionen, Summen zum Zeitpunkt des Speicherns
  createdAt     DateTime @default(now())

  @@unique([quoteId, versionNumber])
}

model Dashboard {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name    String  @default("Mein Dashboard")
  layout  Json    // Widget-Positionen, -Größen, -Typen
}
