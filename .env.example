DATABASE_URL="postgresql://user:password@localhost:5432/taskorga?schema=public"

# Für Login (NextAuth). NEXTAUTH_SECRET: beliebige lange Zufallszeichenkette.
# Lokal erzeugen z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="bitte-durch-zufaellige-zeichenkette-ersetzen"
NEXTAUTH_URL="http://localhost:3000"

# Für echten Datei-Upload (Dokumente-Tab). Token bekommst du im Vercel-Dashboard
# unter Storage → Blob → Store erstellen → ".env.local" Tab zeigt dir den Wert.
BLOB_READ_WRITE_TOKEN="bitte-aus-vercel-dashboard-kopieren"
