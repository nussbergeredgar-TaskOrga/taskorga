DATABASE_URL="postgresql://user:password@localhost:5432/taskorga?schema=public"

# Für Login (NextAuth). NEXTAUTH_SECRET: beliebige lange Zufallszeichenkette.
# Lokal erzeugen z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="bitte-durch-zufaellige-zeichenkette-ersetzen"
NEXTAUTH_URL="http://localhost:3000"

# Für echten Datei-Upload (Dokumente-Tab). Token bekommst du im Vercel-Dashboard
# unter Storage → Blob → Store erstellen → ".env.local" Tab zeigt dir den Wert.
BLOB_READ_WRITE_TOKEN="bitte-aus-vercel-dashboard-kopieren"

# Optional: Adresse der separaten Marketing-Webseite (taskorga-website). Wenn
# gesetzt, landen Nutzer nach dem Ausloggen dort statt auf der App-eigenen
# Login-Seite. Ohne diese Variable bleibt das bisherige Verhalten (/login).
NEXT_PUBLIC_MARKETING_URL=""

# Für E-Mail-Versand (Resend). Ohne RESEND_API_KEY funktioniert kein
# Mail-Versand (Passwort-Reset, Einladungen, Update-Anfragen, ...).
RESEND_API_KEY="bitte-aus-resend-dashboard-kopieren"
EMAIL_FROM="TaskOrga <onboarding@resend.dev>"

# Master-Passwort für /plattform-admin.
PLATFORM_ADMIN_SECRET="bitte-durch-zufaellige-zeichenkette-ersetzen"

# Empfänger für interne Betriebs-Mails (z. B. "Update anfordern"-Button).
PLATFORM_OPERATOR_EMAIL="deine-eigene-adresse@example.com"

# Stripe-Abo-Abrechnung.
STRIPE_SECRET_KEY="bitte-aus-stripe-dashboard-kopieren"
STRIPE_PRICE_ID="bitte-aus-stripe-dashboard-kopieren"
